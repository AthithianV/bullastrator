{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "asyncian",
  "version": "0.1.0",
  "identifier": "asyncian",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY1MTFBM0FBMDdEMTcwMDkKUldRSmNORUhxcU1SOVNveFBlODJJUkQzZ1kvdmlaUlR4QnNXZDk3ci9wYWhDZjA4d3lNTFh6aDUK",
      "endpoints": ["https://releases.asyncian.dev/latest.json"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["asyncian"]
      }
    }
  }
}
