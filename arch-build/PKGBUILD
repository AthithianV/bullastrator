# PKGBUILD for Bullastrator
install="bullastrator.install"
pkgname=bullastrator
pkgver=0.1.0
pkgrel=1
pkgdesc="Desktop GUI for BullMq"
arch=('x86_64')
url="https://bullastrator.dev"
license=('MIT')
depends=('webkit2gtk-4.1' 'openssl' 'libappindicator-gtk3')

package() {
  local project_root="${startdir}/.."

  # The Cargo package is named bullastrator-desktop, so this is the
  # executable produced by `cargo build --release -p bullastrator-desktop`.
  install -Dm755 \
    "${project_root}/crates/target/release/bullastrator-desktop" \
    "${pkgdir}/usr/bin/bullastrator"

  install -Dm644 \
    "${project_root}/crates/bullastrator_desktop/icons/icon.png" \
    "${pkgdir}/usr/share/pixmaps/bullastrator.png"

  install -Dm644 \
    "${startdir}/bullastrator.desktop" \
    "${pkgdir}/usr/share/applications/bullastrator.desktop"
}
